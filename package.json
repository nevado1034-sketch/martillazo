{
  "name": "martillazo",
  "version": "0.1.0",
  "private": true,
  "description": "Martillazo — Plataforma P2P de subastas (Cachivaches y Bienes Raíces)",
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:web": "npm --workspace web run dev",
    "dev": "concurrently -n backend,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:web\"",
    "start": "npm --workspace backend run start",
    "build": "npm --workspace web run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
