# Vacío = mismo origen (proxy Vite → API :4000). Mejor para Try Live / túnel público.
# Para apuntar directo a la API: VITE_API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=

# Soft launch / producción: dejar false u omitir (default). Solo local/dev:
# VITE_ENABLE_SANDBOX_PAY=true
VITE_ENABLE_SANDBOX_PAY=false
