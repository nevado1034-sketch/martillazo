# Vacío = mismo origen (proxy Vite → API :4000). Mejor para Try Live / túnel público.
# Local directo a la API: VITE_API_BASE_URL=http://localhost:4000
# Producción (Vercel): VITE_API_BASE_URL=https://api.pulgasya.com
VITE_API_BASE_URL=

# Soft launch / producción: dejar false u omitir (default). Solo local/dev:
# VITE_ENABLE_SANDBOX_PAY=true
VITE_ENABLE_SANDBOX_PAY=false

# Login con Google (Firebase Auth). Copialos de Firebase Console
# (Configuración del proyecto → Tus apps → SDK web → firebaseConfig).
# En local agrega http://localhost:5173 y en prod https://pulgasya.com
# a los "dominios autorizados" de Authentication > Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
