# Servidor
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/martillazo

# Redis (opcional — sin REDIS_URL el servidor degrada a caché en memoria)
REDIS_URL=redis://localhost:6379

# JWT (firma de tokens: payload { sub: <userId>, role: <userRole> })
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Proveedor de pagos: MOCK (desarrollo) | STRIPE | CULQI | NIUBIZ
PAYMENT_PROVIDER=MOCK
