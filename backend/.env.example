# Servidor
PORT=4000
NODE_ENV=development
# Orígenes del front (CORS + Socket.IO). Varios: separados por coma.
# Soft launch prod: https://pulgasya.com,https://www.pulgasya.com
CLIENT_ORIGIN=http://localhost:5173
# Alternativa a CLIENT_ORIGIN (misma semántica; gana si está definida):
# ORIGINS=https://pulgasya.com,https://www.pulgasya.com

# PostgreSQL (Neon en prod: postgresql://…@….neon.tech/neondb?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/martillazo

# Redis (opcional — sin REDIS_URL el servidor degrada a caché en memoria)
REDIS_URL=redis://localhost:6379

# JWT (firma de tokens: payload { sub: <userId>, role: <userRole> })
# PRODUCCIÓN: obligatorio, ≥ 32 chars, NUNCA "dev-only-secret" (el API no arranca).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Comisión PulgasYa sobre monto en custodia (vendedor recibe 100% − %). Default 10.
PULGASYA_COMMISSION_PERCENT=10

# Proveedor de pagos: MOCK (desarrollo) | CULQI | NIUBIZ | MERCADOPAGO
# Escrow marketplace usa SANDBOX hasta conectar Culqi/Niubiz/MP (sin PAN/CVV).
# En NODE_ENV=production el endpoint pay-sandbox está bloqueado.
PAYMENT_PROVIDER=MOCK
# Opcional en no-prod: ENABLE_SANDBOX_PAY=false para apagar sandbox antes de prod
ENABLE_SANDBOX_PAY=
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
NIUBIZ_CLIENT_ID=
NIUBIZ_CLIENT_SECRET=
MERCADOPAGO_ACCESS_TOKEN=

# Cron HTTP: POST /api/escrow/jobs/auto-release requiere header X-Job-Secret
# En producción JOB_SECRET es obligatorio (sin él → 503).
JOB_SECRET=

# Webhook: POST /api/escrow/webhooks/provider requiere header X-Webhook-Secret
# En producción ESCROW_WEBHOOK_SECRET es obligatorio (sin él → 503; no body abierto).
ESCROW_WEBHOOK_SECRET=

# Mediación admin: role=ADMIN en users, o lista de correos (coma-separada)
ADMIN_EMAILS=

# Seed demo: NO aplicar database/seed_pulgasya_demo.sql en prod.
# Tras migrar, si el demo ya existía: psql … -f database/migrations/009_disable_demo_user.sql
SEED_DEMO=false

# SMTP para reset de contraseña (sin host → log en consola del API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PulgasYa <noreply@pulgasya.local>
SUPPORT_EMAIL=soporte@pulgasya.com

# --- Login con Google (Firebase Auth) ---
# Verifica el ID token de Google. Opciones (en orden de preferencia):
# 1) FIREBASE_SERVICE_ACCOUNT_KEY con el JSON (como string) de una service account
#    (Consola Firebase → Configuración del proyecto → Cuentas de servicio).
# 2) Sin service account: en Vercel/Render se puede usar ADC; local pon al menos
#    FIREBASE_PROJECT_ID para validar el token con las llaves públicas de Google.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=

# --- Uploads ---
# Driver de almacenamiento: local (disco del servidor) | s3 (R2 / S3 / B2).
# Producción escalable: s3. Con local, define un disco persistente.
UPLOADS_DRIVER=local
# Solo con UPLOADS_DRIVER=local. Vacío = backend/uploads/media.
# En Render: UPLOADS_DIR=/var/data/uploads + disco persistente en /var/data.
UPLOADS_DIR=

# --- Object storage compatible con S3 (solo con UPLOADS_DRIVER=s3) ---
# Cloudflare R2: endpoint https://<accountid>.r2.cloudflarestorage.com, region auto.
# AWS S3: deja S3_ENDPOINT vacío y usa p. ej. S3_REGION=us-east-1.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública o CDN del bucket, sin "/" final.
# R2: https://pub-xxxxxxxx.r2.dev o tu dominio (https://media.pulgasya.com)
S3_PUBLIC_URL=
# Prefijo de las claves dentro del bucket. Default: uploads
S3_PREFIX=uploads
# MinIO/Backblaze pueden requerir true. R2/AWS: false.
S3_FORCE_PATH_STYLE=false

